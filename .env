# Kick Developer app credentials (dev.kick.com)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:8000/kick/callback

# In the Kick Developer app, set its Webhook URL to this exact public URL.
# Expose only local port 8001 with a tunnel; the dashboard remains on port 8000.
KICK_WEBHOOK_PUBLIC_URL=https://your-public-tunnel.example/kick/webhook
KICK_WEBHOOK_PATH=/kick/webhook
WEBHOOK_PORT=8001
WEBHOOK_BIND_HOST=0.0.0.0

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Azure AI Speech: create a Speech resource and copy its key/region.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
TTS_VOICE=tr-TR-EmelNeural
TTS_RATE_PERCENT=0
TTS_VOLUME=85

# Set this to the playback device that OBS should capture (for example, VB-CABLE).
# Leave blank to use the Windows default playback device.
AUDIO_DEVICE_NAME=

# Local dashboard
DASHBOARD_HOST=localhost
DASHBOARD_PORT=8000
ASSISTANT_NAME=Mira

# Chat filtering and speaking frequency
MAX_MESSAGE_LENGTH=350
MAX_CONTEXT_MESSAGES=24
MAX_DASHBOARD_MESSAGES=120
USER_COOLDOWN_SECONDS=90
RESPONSE_COOLDOWN_SECONDS=18
MAX_RESPONSES_PER_MINUTE=3
MESSAGE_BATCH_SECONDS=2.5
SPONTANEOUS_MIN_INTERVAL_SECONDS=240
SPONTANEOUS_MIN_MESSAGES=10
MIN_IMPORTANCE_SCORE=24
MAX_SPEECH_CHARS=700
WEBHOOK_MAX_AGE_SECONDS=300
BLOCKED_TERMS=amk,aq,orospu,piç,sik,yarrak,göt,ananı,avradını,gerizekalı
